    {
      "id": "pRqvmuHg50s3gQMdCtqqg",
      "type": "text",
      "x": -2014.166666666664,
      "y": 632731.9166666669,
      "width": 4595.147546681881,
      "height": 1144.5833333333721,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bkL",
      "roundness": null,
      "seed": 628096058,
      "version": 209,
      "versionNonce": 826989222,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779041602265,
      "link": null,
      "locked": false,
      "text": "Orthogonal and orthonormal bases are important in machine\nlearning because they can be used to simplify computations\nand reduce numerical errors. For example, principal component\nanalysis (PCA) is a dimensionality reduction technique that involves finding\nan orthonormal basis for the data. This new basis,\nformed by the principal components, captures the most variance\nin the data while minimizing the reconstruction error.",
      "fontSize": 130.80952380952817,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Orthogonal and orthonormal bases are important in machine\nlearning because they can be used to simplify computations\nand reduce numerical errors. For example, principal component\nanalysis (PCA) is a dimensionality reduction technique that involves finding an orthonormal basis for the data. This new basis,\nformed by the principal components, captures the most variance\nin the data while minimizing the reconstruction error.",
      "autoResize": false,
      "lineHeight": 1.25
    },
