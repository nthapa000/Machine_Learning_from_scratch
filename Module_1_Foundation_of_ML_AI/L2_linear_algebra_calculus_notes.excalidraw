    {
      "id": "APzyoYxSAK7CfYKHcLIXV",
      "type": "text",
      "x": -2007.4999999999977,
      "y": 627265.2500000001,
      "width": 3463.6663411458335,
      "height": 832.5,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "biE",
      "roundness": null,
      "seed": 436723622,
      "version": 116,
      "versionNonce": 1434648314,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779040423719,
      "link": null,
      "locked": false,
      "text": "A set of vectors v1, v2,..., vn is called an orthogonal set if every pair\nof vectors in the set is orthogonal. If,\nin addition, all the vectors in the set have a magnitude of 1,\nthen the set is called an orthonormal set. An orthogonal (or\northonormal) basis for a vector space V is a basis for V that is\nalso an orthogonal (or orthonormal) set",
      "fontSize": 111,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A set of vectors v1, v2,..., vn is called an orthogonal set if every pair of vectors in the set is orthogonal. If,\nin addition, all the vectors in the set have a magnitude of 1,\nthen the set is called an orthonormal set. An orthogonal (or\northonormal) basis for a vector space V is a basis for V that is\nalso an orthogonal (or orthonormal) set",
      "autoResize": false,
      "lineHeight": 1.25
    },
