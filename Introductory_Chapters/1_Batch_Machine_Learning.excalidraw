    {
      "id": "d1PuFjUPmLmuvhjfnf3f-",
      "type": "text",
      "x": -1022.5,
      "y": 433984,
      "width": 1583.089599609375,
      "height": 845,
      "angle": 0,
      "strokeColor": "#fab005",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c2Ih",
      "roundness": null,
      "seed": 210185612,
      "version": 43,
      "versionNonce": 739608380,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1777282640748,
      "link": null,
      "locked": false,
      "text": "With a single global threshold (T):\n\nTop region (bright background + faint text) → text gets lost\nBottom region (dark background) → background becomes \nforeground (noise)\n\nFinal Answer\nPoor segmentation\nLoss of text in bright regions\nFalse positives in dark regions\n\nReason: Global threshold assumes uniform illumination, which \nis violated here.",
      "fontSize": 52,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "With a single global threshold (T):\n\nTop region (bright background + faint text) → text gets lost\nBottom region (dark background) → background becomes \nforeground (noise)\n\nFinal Answer\nPoor segmentation\nLoss of text in bright regions\nFalse positives in dark regions\n\nReason: Global threshold assumes uniform illumination, which \nis violated here.",
      "autoResize": true,
      "lineHeight": 1.25
    },
