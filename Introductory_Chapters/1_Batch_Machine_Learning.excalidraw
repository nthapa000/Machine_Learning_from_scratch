    {
      "id": "YTxriAzwk85_lr4CHeYQ8",
      "type": "text",
      "x": -932.5,
      "y": 436101.5,
      "width": 1217.7371826171875,
      "height": 1105,
      "angle": 0,
      "strokeColor": "#fab005",
      "backgroundColor": "transparent",
